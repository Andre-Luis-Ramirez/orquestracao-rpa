# Conexao com o banco da aplicacao (banco 'rpa' no Postgres do Docker)
DATABASE_URL=postgresql+psycopg2://prefect:prefect@localhost:5433/rpa

# URL da API do Prefect (server rodando no Docker)
PREFECT_API_URL=http://localhost:4200/api

# Caminho do diretorio monitorado (onde a planilha e colocada)
WATCH_DIR=./data/entrada

# URL do sistema alvo (RPA Challenge)
TARGET_URL=https://rpachallenge.com/

# Agendamento do monitoramento (python -m src.servir)
# Se AGENDAMENTO_CRON estiver preenchido, ele tem prioridade sobre o intervalo.
# Exemplo: AGENDAMENTO_CRON=0 18 * * *   (todo dia as 18h)
AGENDAMENTO_CRON=
AGENDAMENTO_FUSO=America/Sao_Paulo
AGENDAMENTO_INTERVALO_SEGUNDOS=60
# false para ver o Chrome trabalhando durante o monitoramento
MONITORAMENTO_HEADLESS=true

# Esperas (em segundos) entre as 3 novas tentativas de uma rodada que falhou
RETRY_DELAYS=10,30,60

# Relatorio por e-mail (RF08). Gmail: use uma "senha de app" (exige verificacao
# em duas etapas na conta), digitada sem espacos. Nunca coloque a senha no codigo.
# Porta 587 = STARTTLS; porta 465 = SSL direto.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
# Varios destinatarios: separe por virgula
EMAIL_DESTINATARIO=
